# Server process is pinned to TZ=America/New_York by the npm scripts.
PORT=3000

# Home location (Raleigh, NC by default)
LATITUDE=35.7796
LONGITUDE=-78.6382

# Twitch (dev.twitch.tv -> register app -> client_credentials flow)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGINS=

# ReCollect (Raleigh). Pull both IDs once from the iCal subscribe link
# in the Raleigh Reuse tool; the client_id query param can be stripped.
RECOLLECT_PLACE_ID=
RECOLLECT_SERVICE_ID=

# Indoor conditions for the luften calculation.
# Assumed constants until a real sensor POSTs to /api/indoor.
INDOOR_TEMP_F=70
INDOOR_RH=50

# Optional. MyMemory (Russian -> English headline translation) allows 5,000
# characters/day anonymously; supplying a contact address raises it to 50,000.
# Leave blank to stay anonymous — the address is sent with every request.
MYMEMORY_EMAIL=
