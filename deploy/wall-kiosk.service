[Unit]
Description=Wall dashboard kiosk browser
After=wall-dashboard.service systemd-user-sessions.service
Wants=wall-dashboard.service
StartLimitIntervalSec=0

[Service]
User=wall

# PAMName + TTYPath + StandardInput=tty are what let a non-root user own a real
# VT. Without them startx refuses, and the usual workaround — autologin on
# tty1 plus startx from a shell profile — puts a login shell in the boot path
# for no benefit.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
UnsetEnvironment=TERM

# -keeptty is required when systemd already owns the tty; -novtswitch stops X
# from flipping away from tty1 on exit, which otherwise leaves a blank console
# on the wall for the second or two before the restart.
ExecStart=/usr/bin/startx /opt/wall-dashboard/deploy/kiosk.sh -- vt1 -keeptty -nolisten tcp -novtswitch

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
