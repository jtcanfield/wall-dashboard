[Unit]
Description=Wall dashboard server
After=network-online.target
Wants=network-online.target
# The panel is the entire purpose of this machine. Never give up restarting it.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
Group=kiosk

# The working directory is load-bearing, not cosmetic. Runtime paths (config/,
# data/, client/dist) resolve from __dirname and hold wherever this is
# installed, but @nestjs/config resolves envFilePath relative to cwd — so .env
# at the repo root is only found from here.
WorkingDirectory=/opt/wall-dashboard

# NODE_ENV=production is what makes Nest serve the built client on :3000
# instead of leaving it to Vite. In dev that split is deliberate; here there is
# only one process and one URL.
Environment=NODE_ENV=production

# TZ is read once at process start, so it has to come from the environment
# rather than from application code. Every timestamp on this panel is local
# wall-clock: the commute markers and luften windows shift quietly if it is
# wrong, and nothing errors.
Environment=TZ=America/New_York

ExecStart=/usr/bin/node --enable-source-maps server/dist/server/src/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
